```gitignore
# ============================================================
# 1. NODE.JS / NESTJS / VUE.JS — DEPENDENCIES
# ============================================================

node_modules/
jspm_packages/
web_modules/
.npm/
.pnp
.pnp.js

# npm / Yarn / pnpm caches
.npm-cache/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz
.pnpm-store/

# ============================================================
# 2. NODE.JS / NESTJS / VUE.JS — BUILD OUTPUTS
# ============================================================

# General build outputs
dist/
build/
*.tsbuildinfo

# Vue / Vite
.vite/
dist-ssr/
*.local

# NestJS
# Note: dist/ is already ignored above.

# ============================================================
# 3. PYTHON — VIRTUAL ENVIRONMENTS
# ============================================================

.venv/
venv/
env/
ENV/
.python-version.local

# ============================================================
# 4. PYTHON — CACHE / COMPILED FILES
# ============================================================

__pycache__/
*.py[cod]
*$py.class
*.so
.python-version

# ============================================================
# 5. PYTHON — PACKAGING / DISTRIBUTION
# ============================================================

build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ============================================================
# 6. MACHINE LEARNING — DATASETS / MODELS / EXPERIMENTS
# ============================================================

# Dataset files — review before ignoring if you need to version
# small, public, reproducible sample datasets.
data/
datasets/

# Trained models and serialized artifacts
models/
checkpoints/
*.pkl
*.pickle
*.joblib
*.h5
*.hdf5
*.keras
*.pt
*.pth
*.onnx
*.safetensors
*.model
*.weights

# Experiment tracking
mlruns/
mlartifacts/
wandb/
.tensorboard/
lightning_logs/
checkpoints/

# Jupyter Notebook
.ipynb_checkpoints/
profile/
.prof

# ============================================================
# 7. ENVIRONMENT VARIABLES / SECRETS
# ============================================================

.env
.env.*
!.env.example
!.env.*.example

# Private keys and certificates
*.pem
*.key
*.p12
*.pfx

# Service account credentials
credentials.json
service-account*.json

# ============================================================
# 8. LOGS / DIAGNOSTICS
# ============================================================

logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Node process files
*.pid
*.seed
*.pid.lock

# ============================================================
# 9. TESTING / QUALITY ASSURANCE
# ============================================================

# JavaScript / TypeScript
coverage/
.nyc_output/
.eslintcache
.eslintcache/
.stylelintcache
jest-*.log

# Cypress
cypress/videos/
cypress/screenshots/

# Playwright
playwright-report/
test-results/

# General screenshots
__screenshots__/

# Python testing / coverage
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
junit.xml
.hypothesis/

# Type checking / linting
.mypy_cache/
.dmypy.json
pyrightconfig.local.json
.ruff_cache/

# ============================================================
# 10. TYPESCRIPT / JAVASCRIPT TOOLING
# ============================================================

# TypeScript build info
*.tsbuildinfo

# Temporary files
.temp/
.tmp/
*.timestamp-*-*.mjs

# ============================================================
# 11. IDEs / EDITORS
# ============================================================

# VS Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.iml

# Eclipse / Cloud9
.project
.classpath
.c9/
*.launch
.settings/

# Sublime Text
*.sublime-workspace

# Vim / Emacs
*~
*.swp
*.swo
*.bak
.#*

# ============================================================
# 12. OPERATING SYSTEM FILES
# ============================================================

.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ============================================================
# 13. DOCKER / LOCAL DEVELOPMENT
# ============================================================

# Local Docker overrides
docker-compose.override.yml
compose.override.yaml

# Local development certificates
certs/
secrets/

# ============================================================
# 14. LOCAL DATABASES / GENERATED FILES
# ============================================================

*.sqlite
*.sqlite3
*.db

# ============================================================
# 15. OPTIONAL LOCAL CONFIGURATION
# ============================================================

# Local-only configuration files
.envrc
.direnv/
```
